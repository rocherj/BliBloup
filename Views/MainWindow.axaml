<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BoomBx.ViewModels"
        xmlns:views="using:BoomBx.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:BoomBx.Converters"
        mc:Ignorable="d" 
        x:Class="BoomBx.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:model="using:BoomBx.Models"
        xmlns:g="using:"
        Icon="/Assets/logo.png"
        Title="BoomBx"
        Background="#1A1A1A"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        CanResize="True"
        Width="1200"
        Height="800"
        MinWidth="980"
        MinHeight="620">
    
    <Window.Resources>
        <conv:UriToImageSourceConverter x:Key="UriConverter"/>
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>

        <ControlTheme x:Key="CustomListBoxItemTheme" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="#1A1A1A"/>
            </Style>
            <Style Selector="^:focused">
                <Setter Property="Background" Value="#1A1A1A"/>
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#1A1A1A"/>
            </Style>
            <Style Selector="^:selected:focused">
                <Setter Property="Background" Value="#1A1A1A"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Background="#1A1A1A"
          HorizontalAlignment="Stretch" 
          VerticalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="{Binding #SoundsNav.IsChecked, Converter={StaticResource BoolToGridLengthConverter}}"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252525" Margin="0,0,1,0">
            <StackPanel Spacing="0">
                <Border Padding="15" Background="#2D2D2D">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="50" Height="50"/>
                        <TextBlock Text="BOOMBX" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#E0E0E0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <StackPanel Spacing="10" Margin="10">
                    <RadioButton x:Name="SoundsNav"
                                 GroupName="Nav"
                                 Content="Sounds"
                                 Classes="SidebarButton"
                                 Tag="{x:Static views:NavigationItem.Sounds}"
                                 IsChecked="True"/>
                    
                    <RadioButton x:Name="TextToSpeechNav"
                                 GroupName="Nav"
                                 Content="Text-to-Speech"
                                 Classes="SidebarButton"
                                 Tag="{x:Static views:NavigationItem.TextToSpeech}"
                                 Checked="TextToSpeechNav_Checked"/>
                    
                    <RadioButton x:Name="VoiceChangerNav"
                                 GroupName="Nav"
                                 Content="Voice Changer"
                                 Classes="SidebarButton"
                                 Tag="{x:Static views:NavigationItem.VoiceChanger}"/>
                    
                    <RadioButton x:Name="SettingsNav"
                                 GroupName="Nav"
                                 Content="Settings"
                                 Classes="SidebarButton"
                                 Tag="{x:Static views:NavigationItem.Settings}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#252525" Margin="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Background="#333333" CornerRadius="4" Padding="5" Margin="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="SOUNDBOARDS" Foreground="#B8B8B8" FontSize="12"/>
                        <ListBox ItemsSource="{Binding Soundboards}"
                                 SelectionChanged="SoundboardList_SelectionChanged"
                                 SelectedItem="{Binding SelectedSoundboard, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" 
                                               Foreground="#E0E0E0"
                                               Padding="5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button Content="➕" 
                                    Click="AddSoundboard" 
                                    Width="50" Background="#404040"
                                    Foreground="White"/>
                            <Button Content="✏️" 
                                    Click="RenameSoundboard" 
                                    Width="50" Background="#404040" 
                                    Foreground="White"/>
                            <Button Content="🗑️" 
                                    Click="RemoveSoundboard" 
                                    Width="50" Background="#404040" 
                                    Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
        
        <Border Grid.Column="2" Background="#252525" Margin="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MainUI" 
                            IsVisible="False" 
                            Spacing="20" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Top"
                            Margin="20">
                    <Border Background="#2D2D2D" CornerRadius="8" Padding="25"
                            IsVisible="{Binding #SoundsNav.IsChecked}">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Sound Library" FontSize="22" FontWeight="Bold"
                                    Foreground="#E0E0E0" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Add Sound" Click="AddToLibrary" 
                                        Width="120" Background="#007ACC"/>
                                <Button Content="Remove Selected" Click="RemoveFromLibrary" 
                                        Width="120" Background="#c20000"/>
                                <Button Content="■ Stop All" Click="StopHandler"
                                        Width="120" Background="#404040"/>
                            </StackPanel>

                            <Grid MinHeight="200">
                                <Border Background="#333333" CornerRadius="4">
                                    <ListBox x:Name="SoundsListBox"
                                        SelectionMode="Single" ItemsSource="{Binding SelectedSoundboard.Sounds}"
                                        SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        ItemContainerTheme="{StaticResource CustomListBoxItemTheme}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" 
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                Margin="0 10"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="model:SoundItem">
                                            <Border Classes="listbox-item"
                                                    Width="200" 
                                                    Height="160" 
                                                    Background="#333333" 
                                                    CornerRadius="8"
                                                    Margin="5"
                                                    Padding="6"
                                                    Cursor="Hand">
                                                <Border.Styles>
                                                    <Style Selector="Border.listbox-item:focus">
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </Style>
                                                    <Style Selector="Border.listbox-item">
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Style>
                                                    <Style Selector="Border.listbox-item:pointerover">
                                                        <Setter Property="RenderTransform">
                                                            <TransformGroup>
                                                                <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                                            </TransformGroup>
                                                        </Setter>
                                                    </Style>
                                                </Border.Styles>
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <Border Width="70" 
                                                            Height="70" 
                                                            Background="#404040" 
                                                            CornerRadius="4">
                                                        <Image Source="{Binding IconPath, Converter={StaticResource UriConverter}}"
                                                            Width="36" 
                                                            Height="36"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" 
                                                            Foreground="#E0E0E0"
                                                            FontSize="11"
                                                            TextWrapping="Wrap"
                                                            HorizontalAlignment="Center"
                                                            MaxWidth="100"
                                                            TextAlignment="Center"/>
                                                    <Border IsVisible="{Binding HasHotkey}"
                                                            Background="#007ACC"
                                                            CornerRadius="3"
                                                            Padding="4,0"
                                                            HorizontalAlignment="Center"
                                                            MaxWidth="100">
                                                        <TextBlock Text="{Binding Hotkey}"
                                                                Foreground="White"
                                                                FontSize="8"
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip.Tip="{Binding Hotkey}"/>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                        <Button Content="✎" Width="26" Height="18" Padding="0" FontSize="9"
                                                                Background="#3D3D3D" ToolTip.Tip="Edit hotkey"
                                                                Click="EditHotkeyFromList_Click" Tag="{Binding}"/>
                                                        <Button Content="✕" Width="26" Height="18" Padding="0" FontSize="9"
                                                                Background="#6B2E2E" ToolTip.Tip="Delete sound"
                                                                Click="DeleteSoundFromList_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <Border IsVisible="{Binding !HasSoundsInSelectedBoard}"
                                        Background="#2E2E2E" CornerRadius="6" Margin="6" Padding="20">
                                    <StackPanel VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="This soundboard is empty"
                                                   Foreground="#E8E8E8" FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click “Add Sound” to import MP3 or WAV files."
                                                   Foreground="#A8A8A8" FontSize="12" TextWrapping="Wrap"
                                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <Button Content="Add Sound" Click="AddToLibrary"
                                                HorizontalAlignment="Center" Background="#007ACC"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#2D2D2D" CornerRadius="8" Padding="25"
                            IsVisible="{Binding #TextToSpeechNav.IsChecked}">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Text-to-Speech" 
                                    FontSize="22" 
                                    FontWeight="Bold"
                                    Foreground="#E0E0E0"
                                    HorizontalAlignment="Center"/>
                            
                            <TextBox Text="{Binding TtsText, Mode=TwoWay}"
                                    Watermark="Enter text to speak..."
                                    AcceptsReturn="True"
                                    Height="100"
                                    FontSize="14"
                                    Background="#333333"
                                    Foreground="White"/>
                            
                            <StackPanel Spacing="10">
                                <ComboBox ItemsSource="{Binding AvailableVoices}"
                                        SelectedItem="{Binding SelectedVoice}"
                                        FontSize="14"
                                        Height="40">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Volume:" Foreground="#E0E0E0"/>
                                    <Slider Minimum="0" Maximum="100" 
                                            Value="{Binding TtsVolume, Mode=TwoWay}"
                                            Foreground="#007ACC"/>
                                    
                                    <TextBlock Text="Pitch:" Foreground="#E0E0E0"/>
                                    <Slider Minimum="0.5" Maximum="2.0" 
                                            Value="{Binding TtsPitch, Mode=TwoWay}"
                                            Foreground="#007ACC"/>
                                    
                                    <StackPanel Spacing="5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Speed:" Foreground="#E0E0E0"/>
                                            <TextBlock Text="{Binding TtsSpeed, StringFormat=' {0:F1}x'}" 
                                                    Foreground="#B8B8B8" 
                                                    Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <Slider Minimum="0.1" Maximum="2.0" 
                                                Value="{Binding TtsSpeed, Mode=TwoWay}"
                                                TickFrequency="0.1"
                                                IsSnapToTickEnabled="False"
                                                Foreground="#007ACC"/>
                                        <TextBlock Text="Tip: Use 0.5-0.8 for slower, clearer speech" 
                                                FontSize="11" 
                                                Foreground="#8A8A8A" 
                                                Margin="0,-5,0,5"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Button Content="▶ Preview" 
                                        Click="PreviewTts_Click"
                                        Width="120"
                                        Background="#007ACC"/>
                                
                                <Button Content="💾 Save Audio" 
                                        Click="SaveTtsAudio_Click"
                                        Width="120"
                                        Background="#404040"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#2D2D2D" CornerRadius="8" Padding="25"
                            IsVisible="{Binding #VoiceChangerNav.IsChecked}">
                        <TextBlock Text="AI Voice Changer (Coming Soon)" 
                                Foreground="#B8B8B8" FontSize="16"
                                HorizontalAlignment="Center"/>
                    </Border>

                    <Border Background="#2D2D2D" CornerRadius="8" Padding="25"
                            IsVisible="{Binding #SettingsNav.IsChecked}">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Audio Settings" FontSize="22" FontWeight="Bold"
                                    Foreground="#E0E0E0" HorizontalAlignment="Center"/>
                            
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="PLAYBACK DEVICE" 
                                            Foreground="#B8B8B8"
                                            FontSize="12"
                                            FontWeight="Bold"/>
                                    <ComboBox x:Name="PlaybackComboBox" 
                                        ItemsSource="{Binding PlaybackDevices}"
                                        SelectedItem="{Binding SelectedPlaybackDevice}"
                                        Height="40" 
                                        FontSize="14">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FriendlyName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="MICROPHONE INPUT" 
                                            Foreground="#B8B8B8"
                                            FontSize="12"
                                            FontWeight="Bold"/>
                                            <ComboBox x:Name="CaptureComboBox" 
                                                ItemsSource="{Binding CaptureDevices}"
                                                SelectedItem="{Binding SelectedCaptureDevice}"
                                                Height="40" 
                                                FontSize="14">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FriendlyName}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="15">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,0">
                                    <TextBlock Grid.Column="0" Text="Hotkeys" FontSize="18" FontWeight="SemiBold"
                                            Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Name="HotkeysEnabledBox" Content="Enable global hotkeys"
                                            IsChecked="{Binding HotkeysEnabled, Mode=TwoWay}"
                                            Click="HotkeysEnabledBox_Click"
                                            Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Global combinations work while another application has the focus; playback stays in the background."
                                        Foreground="#8A8A8A" FontSize="11" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Play / Pause Sound" VerticalAlignment="Center" Foreground="#E0E0E0"/>
                                    <TextBox Grid.Column="1" Name="PlayPauseHotkeyTextBox" MinWidth="140"
                                            Text="{Binding PlayPauseHotkey, Mode=OneWay}" IsReadOnly="True"
                                            VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Content="Set" Margin="5,0,0,0"
                                            Click="SetHotkey_Click" Tag="{Binding #PlayPauseHotkeyTextBox}"/>
                                    <Button Grid.Column="3" Content="Test" Width="62" Margin="5,0,0,0"
                                            Click="TestHotkey_Click" Tag="PlayPause"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Stop Sound" VerticalAlignment="Center" Foreground="#E0E0E0"/>
                                    <TextBox Grid.Column="1" Name="StopHotkeyTextBox" MinWidth="140"
                                            Text="{Binding StopHotkey, Mode=OneWay}" IsReadOnly="True"
                                            VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Content="Set" Margin="5,0,0,0"
                                            Click="SetHotkey_Click" Tag="{Binding #StopHotkeyTextBox}"/>
                                    <Button Grid.Column="3" Content="Test" Width="62" Margin="5,0,0,0"
                                            Click="TestHotkey_Click" Tag="Stop"/>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Pause Sound" VerticalAlignment="Center" Foreground="#E0E0E0"/>
                                    <TextBox Grid.Column="1" Name="PauseHotkeyTextBox" MinWidth="140"
                                            Text="{Binding PauseHotkey, Mode=OneWay}" IsReadOnly="True"
                                            VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Content="Set" Margin="5,0,0,0"
                                            Click="SetHotkey_Click" Tag="{Binding #PauseHotkeyTextBox}"/>
                                    <Button Grid.Column="3" Content="Test" Width="62" Margin="5,0,0,0"
                                            Click="TestHotkey_Click" Tag="Pause"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Emergency stop (panic)" VerticalAlignment="Center" Foreground="#E0E0E0"/>
                                    <TextBox Grid.Column="1" Name="PanicHotkeyTextBox" MinWidth="140"
                                            Text="{Binding PanicHotkey, Mode=OneWay}" IsReadOnly="True"
                                            VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Content="Set" Margin="5,0,0,0"
                                            Click="SetHotkey_Click" Tag="{Binding #PanicHotkeyTextBox}"/>
                                    <Button Grid.Column="3" Content="Test" Width="62" Margin="5,0,0,0"
                                            Click="TestHotkey_Click" Tag="Panic"/>
                                </Grid>

                                <TextBlock Text="{Binding LastHotkeyDisplay, StringFormat='Last triggered: {0}'}"
                                        Foreground="#B8B8B8" FontSize="12"/>

                                <TextBlock Text="{Binding HotkeyWarnings}"
                                        IsVisible="{Binding HasHotkeyWarnings}"
                                        Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap"/>

                                <TextBlock Text="Per-clip hotkeys" FontWeight="SemiBold" Foreground="#B8B8B8"
                                        FontSize="12" Margin="0,10,0,0"/>

                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Soundboards}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="g:Soundboard">
                                                <StackPanel Spacing="3" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Name}" Foreground="#8A8A8A"
                                                            FontSize="11" FontWeight="Bold"/>
                                                    <ItemsControl ItemsSource="{Binding Sounds}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="model:SoundItem">
                                                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                                    <TextBlock Text="{Binding Name}" Foreground="#E0E0E0"
                                                                            FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Hotkey}"
                                                                            Foreground="#4FC1FF" FontSize="12"
                                                                            FontFamily="Cascadia Mono, Consolas"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="Assign a clip hotkey from the sound panel on the right: it then plays from anywhere without bringing BoomBx to the front."
                                        Foreground="#8A8A8A" FontSize="11" TextWrapping="Wrap"/>

                                </StackPanel>
                                

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,10,0,0">
                                <Button ToolTip.Tip="GitHub" Click="OpenGitHub" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Image Source="/Assets/github.png" Width="24" Height="24"/>
                                </Button>
                                <Button ToolTip.Tip="Trello" Click="OpenTrello" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Image Source="/Assets/trello.png" Width="24" Height="24"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="{Binding AppVersion}" 
                                    Foreground="#8A8A8A"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="3" Margin="20">
            <!-- Placeholder shown when nothing is selected -->
            <Border IsVisible="{Binding !HasSelectedSound}"
                    Background="#252525" CornerRadius="8" Padding="24">
                <StackPanel VerticalAlignment="Center" Spacing="14">
                    <TextBlock Text="🎧" FontSize="38" HorizontalAlignment="Center"/>
                    <TextBlock Text="No sound selected" Foreground="#E8E8E8" FontSize="18"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a sound in the library to edit its title, volume, hotkey and trim."
                               Foreground="#A8A8A8" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding HasSelectedSound}" Background="#252525" CornerRadius="8">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Fixed header: icon and an obviously editable title -->
                    <Border Grid.Row="0" Background="#2D2D2D" CornerRadius="8,8,0,0" Padding="12">
                        <Grid ColumnDefinitions="Auto,*">
                            <Button Classes="ThumbnailButton" Width="56" Height="56"
                                    Click="ChangeIconClicked"
                                    ToolTip.Tip="Click to change this sound's thumbnail">
                                <Border Width="52" Height="52" Background="#404040" CornerRadius="6">
                                    <Image Source="{Binding SelectedSound.IconPath, Converter={StaticResource UriConverter}}"
                                           Width="52" Height="52"/>
                                </Border>
                            </Button>
                            <StackPanel Grid.Column="1" Spacing="3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TITLE — click to rename" Foreground="#A8A8A8" FontSize="10" FontWeight="Bold"/>
                                <TextBox Classes="EditableTitle"
                                         Text="{Binding SelectedSound.Name, Mode=TwoWay}"
                                         FontSize="14"
                                         Padding="8,4"
                                         ToolTip.Tip="Click to rename this sound"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable settings -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="62,*,46" VerticalAlignment="Center">
                                <TextBlock Text="Volume" Foreground="#B8B8B8" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                        Value="{Binding SelectedSound.Volume, Mode=TwoWay}" Foreground="#007ACC"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedSound.Volume, StringFormat='{}{0:F0}%'}"
                                           Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>

                            <Grid ColumnDefinitions="62,*,46" VerticalAlignment="Center">
                                <TextBlock Text="Bass" Foreground="#B8B8B8" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="-20" Maximum="20"
                                        Value="{Binding SelectedSound.Bass, Mode=TwoWay}" Foreground="#007ACC"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedSound.Bass, StringFormat='{}{0:F0} dB'}"
                                           Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>

                            <Grid ColumnDefinitions="62,*,46" VerticalAlignment="Center">
                                <TextBlock Text="Treble" Foreground="#B8B8B8" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="-20" Maximum="20"
                                        Value="{Binding SelectedSound.Treble, Mode=TwoWay}" Foreground="#007ACC"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedSound.Treble, StringFormat='{}{0:F0} dB'}"
                                           Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>

                            <Grid ColumnDefinitions="62,*,46" VerticalAlignment="Center">
                                <TextBlock Text="Pitch" Foreground="#B8B8B8" FontSize="12" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0"
                                        Value="{Binding SelectedSound.Pitch, Mode=TwoWay}" Foreground="#007ACC"/>
                                <TextBlock Grid.Column="2" Text="{Binding SelectedSound.Pitch, StringFormat='{}{0:F1}x'}"
                                           Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="PLAYBACK HOTKEY" Foreground="#A8A8A8" FontSize="10" FontWeight="Bold"/>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Name="ClipHotkeyTextBox"
                                             Text="{Binding SelectedSound.Hotkey, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Watermark="Not assigned"
                                             VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Set" Margin="5,0,0,0" Padding="10,6"
                                            Click="SetClipHotkey_Click"/>
                                    <Button Grid.Column="2" Content="✕" Width="34" Margin="5,0,0,0" Padding="0,6"
                                            Click="ClearClipHotkey_Click" ToolTip.Tip="Remove this hotkey"/>
                                </Grid>
                            </StackPanel>

                            <CheckBox Content="Loop audio" IsChecked="{Binding IsLoopingEnabled}" Foreground="#E0E0E0"/>

                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Content="Change Icon" Padding="6,6"
                                        Click="ChangeIconClicked" Margin="0,0,3,0"
                                        ToolTip.Tip="Import an image (resized to 256px and compressed)"/>
                                <Button Grid.Column="1" Content="Reset thumbnail" Padding="6,6"
                                        Click="ResetThumbnail_Click" Margin="3,0,0,0"
                                        ToolTip.Tip="Use the default soundboard.png thumbnail"/>
                            </Grid>

                            <Button Content="Save Changes" Padding="6,6" HorizontalAlignment="Stretch"
                                    Click="SaveChangesClicked" Background="#007ACC"/>

                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Content="Duplicate" Padding="6,6"
                                        Click="DuplicateSound_Click" Tag="{Binding SelectedSound}" Margin="0,0,3,0"/>
                                <Button Grid.Column="1" Content="Delete" Padding="6,6"
                                        Click="DeleteSoundFromList_Click" Tag="{Binding SelectedSound}"
                                        Background="#8B2E2E" Margin="3,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Fixed footer: trim editor and transport are always visible -->
                    <Border Grid.Row="2" Background="#2D2D2D" CornerRadius="0,0,8,8" Padding="12">
                        <StackPanel Spacing="8">
                            <Expander IsExpanded="False" HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="TRIM" Foreground="#A8A8A8" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ClipDurationText}" Foreground="#8A8A8A" FontSize="10"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="6" Margin="0,6,0,0">
                                    <views:WaveformView Height="54"
                                                        Peaks="{Binding ClipPeaks}"
                                                        Duration="{Binding ClipDurationSeconds}"
                                                        SelectionStart="{Binding TrimStartSeconds}"
                                                        SelectionEnd="{Binding TrimEndSeconds}"/>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Text="Start" Foreground="#B8B8B8" FontSize="11" Width="36"/>
                                        <Slider Grid.Column="1" Name="TrimStartSlider"
                                                Minimum="0" Maximum="1"
                                                Value="{Binding TrimStartSeconds}"
                                                ValueChanged="TrimStartSlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TrimStartText}" Foreground="#E0E0E0"
                                                   FontSize="11" Width="48" TextAlignment="Right"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Text="End" Foreground="#B8B8B8" FontSize="11" Width="36"/>
                                        <Slider Grid.Column="1" Name="TrimEndSlider"
                                                Minimum="0" Maximum="1"
                                                Value="{Binding TrimEndSeconds}"
                                                ValueChanged="TrimEndSlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TrimEndText}" Foreground="#E0E0E0"
                                                   FontSize="11" Width="48" TextAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="{Binding TrimSelectionText}" Foreground="#8A8A8A"
                                               FontSize="10" TextWrapping="Wrap"/>

                                    <Button Content="▶ Preview selection" FontSize="12" Padding="8,6"
                                            HorizontalAlignment="Stretch" Click="PreviewTrim_Click"/>
                                    <Grid ColumnDefinitions="*,*">
                                        <Button Grid.Column="0" Content="Save copy" FontSize="11" Padding="6,6"
                                                Click="SaveTrimCopy_Click" Margin="0,0,3,0"/>
                                        <Button Grid.Column="1" Content="Overwrite" FontSize="11" Padding="6,6"
                                                Click="SaveTrimOverwrite_Click" Background="#8B2E2E" Margin="3,0,0,0"/>
                                    </Grid>
                                    <Button Content="Reset trim" FontSize="11" Background="Transparent"
                                            HorizontalAlignment="Left" Padding="0" Click="ResetTrim_Click"/>
                                </StackPanel>
                            </Expander>

                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0" x:Name="PlayPauseButton" Content="▶ Play"
                                        FontSize="15" Height="42" Background="#007ACC" Foreground="White"
                                        Click="PlayPauseHandler" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" x:Name="StopButton" Content="■ Stop"
                                        FontSize="15" Width="100" Height="42" Background="#404040" Foreground="White"
                                        Click="StopHandler"/>
                            </Grid>

                            <TextBlock x:Name="StatMessage" Foreground="#B8B8B8" FontSize="12"
                                       TextWrapping="Wrap" MinHeight="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="InstallationPanel" Grid.ColumnSpan="3"
                Background="#2D2D2D" 
                Padding="20" 
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ZIndex="100"
                IsVisible="False">
            <StackPanel Spacing="15">
                <TextBlock Text="VB-Cable Installation" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Foreground="#E0E0E0"/>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Spacing="15">
                    <Button Content="Install Now" 
                            Click="OnInstallClicked" 
                            Width="120"
                            Background="#007ACC"
                            Foreground="White"/>
                    <Button Content="Install Later" 
                            Click="OnExitClicked" 
                            Width="120"
                            Background="#404040"
                            Foreground="White"/>
                </StackPanel>
                <TextBlock x:Name="InstallationMessageT1" 
                           VerticalAlignment="Center"
                           Foreground="#E0E0E0"
                           FontSize="13"
                           Text="It appears you don't have VB-Cable, some functionalities may not work."/>
                <TextBlock x:Name="InstallationMessageT" 
                           VerticalAlignment="Center"
                           Foreground="#E0E0E0"
                           FontSize="13"/>
            </StackPanel>
        </Border>

        <Border x:Name="ProgressBarContainer" Grid.ColumnSpan="3"
                Background="#252525" 
                Height="50"
                VerticalAlignment="Bottom"
                Padding="15"
                CornerRadius="4"
                IsVisible="False">
            <StackPanel Orientation="Horizontal" 
                        Spacing="15"
                        VerticalAlignment="Center">
                <ProgressBar Width="250" 
                             Height="8" 
                             IsIndeterminate="True"
                             Foreground="#007ACC"/>
                <TextBlock x:Name="ProgressStatus" 
                           VerticalAlignment="Center"
                           Foreground="#E0E0E0"
                           FontSize="13"/>
                <TextBlock x:Name="InstallationMessage" 
                           VerticalAlignment="Center"
                           Foreground="#E0E0E0"
                           FontSize="13"/>
                <TextBlock x:Name="StatusMessage" 
                           VerticalAlignment="Center"
                           Foreground="#E0E0E0"
                           FontSize="13"/>
            </StackPanel>
        </Border>

        <Border x:Name="BottomContainer" Grid.ColumnSpan="3"
                Background="#252525" 
                Height="50"
                VerticalAlignment="Bottom"
                Padding="15"
                CornerRadius="4"
                IsVisible="True">
            <StackPanel Orientation="Horizontal" 
                        Spacing="15"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StatoMessage" 
                           VerticalAlignment="Center"
                           Foreground="#E0E0E0"
                           FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>