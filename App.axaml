<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BliBloup.App"
             xmlns:local="using:BliBloup"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ScaleTransform x:Key="VerticalSmallScrollThumbScaleTransform" ScaleX="1" ScaleY="1"/>
        <ScaleTransform x:Key="HorizontalSmallScrollThumbScaleTransform" ScaleX="1" ScaleY="1"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackground">#070707</SolidColorBrush>
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver">#111111</SolidColorBrush>
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed">#050505</SolidColorBrush>
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush">#1A1A1A</SolidColorBrush>
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver">#2A2A2A</SolidColorBrush>
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed">#2A2A2A</SolidColorBrush>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />



        <Style Selector="RadioButton.SidebarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Content="{TemplateBinding Content}"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.SidebarButton:checked /template/ Border#border">
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="Background" Value="#2D2D2D"/>
        </Style>

        <Style Selector="RadioButton.SidebarButton:checked">
            <Setter Property="Foreground" Value="#007ACC"/>
        </Style>

        <Style Selector="RadioButton.SidebarButton:pointerover /template/ Border#border">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
        </Style>

        <!-- ComboBox Styles -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12 8"/>
        </Style>

        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="#007ACC"/>
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12 8"/>
        </Style>

        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ListBox Styles -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#007ACC20"/>
        </Style>

        <!-- Button Styles -->
        <Style Selector="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14 8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#3D3D3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="16"/>
        </Style>

        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="16"/>
        </Style>

        <!-- Keep the Fluent Track/Thumb (native dragging) but hide the arrow line buttons. -->
        <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="#2E2E2E"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style Selector="ScrollBar Thumb">
            <Setter Property="Background" Value="#4A4A4A"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="ScrollBar Thumb:pointerover">
            <Setter Property="Background" Value="#007ACC"/>
        </Style>

        <Style Selector="ScrollBar Thumb:pressed">
            <Setter Property="Background" Value="#007ACC"/>
        </Style>

        <!-- TextBox styling -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- Slider track styling -->
        <Style Selector="Slider">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Height" Value="4"/>
        </Style>

        <Style Selector="Slider:track">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Slider:filled">
            <Setter Property="Background" Value="#007ACC"/>
        </Style>

        <!-- Slider Styles -->
        <Style Selector="Slider">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <!-- BorderBrush is the outer ring, Background the inner circle. -->
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="Background" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="#666666"
                                 Width="18" Height="18"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Fill="#CCCCCC"
                                 Width="10" Height="10"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Slider:pointerover /template/ Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="#007ACC"
                                 Width="18" Height="18"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Fill="#FFFFFF"
                                 Width="10" Height="10"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Slider:pressed /template/ Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="#007ACC"
                                 Width="18" Height="18"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Fill="#999999"
                                 Width="10" Height="10"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Focus and contrast polish: every interactive control shows a clear keyboard focus ring -->
        <Style Selector="Button:focus-visible">
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="#5A5A5A"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#007ACC"/>
        </Style>

        <Style Selector="TextBox.EditableTitle">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBox.EditableTitle:pointerover">
            <Setter Property="BorderBrush" Value="#007ACC"/>
        </Style>


        <Style Selector="CheckBox:focus-visible">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.ThumbnailButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="Button.ThumbnailButton:pointerover">
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="Background" Value="#007ACC20"/>
        </Style>

        <!-- Right/left pane expanders: same grey as the soundboard blocks, rounded corners. -->
        <Style Selector="Expander">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="#070707"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="Expander:pointerover /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="#111111"/>
        </Style>

        <!-- Sound tile selection: a complete rounded frame around the tile content. -->
        <Style Selector="Border.SoundTile">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Border.SoundTile:pointerover">
            <Setter Property="BorderBrush" Value="#007ACC80"/>
            <Setter Property="RenderTransform">
                <TransformGroup>
                    <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                </TransformGroup>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:selected Border.SoundTile">
            <Setter Property="BorderBrush" Value="#007ACC"/>
        </Style>

    </Application.Styles>
</Application>